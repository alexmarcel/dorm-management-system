DATABASE_PATH=./data/paini.db
UPLOAD_DIR=./data/photos
APP_ORIGIN=http://localhost:3000
PAINI_SUPERADMIN_USERNAME=
PAINI_SUPERADMIN_PASSWORD=
# Persistent maintenance state; keep outside the application release directory.
CONTROL_DIR=./data/control
# Maximum compressed archive size; expanded contents are limited to 4x this value.
MAX_BACKUP_BYTES=1073741824
# Production: use absolute persistent paths outside the release directory.
# S3_BUCKET enables private S3 storage instead of the local development adapter.
# S3_BUCKET=
# S3_REGION=ap-southeast-1
# S3_ENDPOINT=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Production requires an exact HTTPS APP_ORIGIN, without a trailing slash.
# Example only: https://paini.example.invalid
# No proxy secrets or Traefik changes required. PAINI creates its own private
# identifier key in CONTROL_DIR. Missing limit overrides use the defaults below.
LOGIN_GLOBAL_LIMIT=120
LOGIN_UNKNOWN_SOURCE_LIMIT=60
LOGIN_SOURCE_LIMIT=30
LOGIN_ACCOUNT_SOURCE_LIMIT=10
LOGIN_CONCURRENCY=4
# Short windows are 60 seconds; daily windows are 24 hours from first usage.
QUOTA_STUDENT_MUTATIONS=60
QUOTA_STUDENT_UPLOADS=20
QUOTA_STUDENT_BYTES=10000000
QUOTA_STUDENT_REPORTS=10
QUOTA_STUDENT_EVENTS=50
QUOTA_STUDENT_RETAINED=100000000
QUOTA_WARDEN_MUTATIONS=300
QUOTA_WARDEN_UPLOADS=60
QUOTA_WARDEN_BYTES=50000000
QUOTA_WARDEN_REPORTS=10
QUOTA_WARDEN_EVENTS=300
QUOTA_WARDEN_RETAINED=500000000
# Superadmin defaults match warden values; maintenance access does not allow photos/reports.
QUOTA_SUPERADMIN_MUTATIONS=300
